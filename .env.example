# Theia — environment configuration
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── HydraDB (required) ───────────────────────────────────────────────────────
# Bolt endpoint for the local HydraDB graph node.
# Must match the container's own GRAPH_ADVERTISED_BOLT_ADDR. Do not point this at
# a WSL VM IP (172.x) — it is not reachable from the Windows host and changes on
# every restart.
HYDRA_BOLT_URI=bolt://127.0.0.1:7687

# ─── Gemini (optional — affects EXTRACTION only) ──────────────────────────────
# When set, extraction/hybrid_extractor.py uses Gemini for entity/fact extraction, with a
# circuit breaker that falls back to deterministic heuristics on quota or rate-limit
# errors. When unset, extraction is heuristic-only (pure regex/rules).
#
# This changes the CONTENT of the graph, so ingesting with and without a key
# produces different fact counts and different benchmark numbers. It does NOT
# affect answering: the query engine never calls an LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Composio (optional — live SaaS integrations) ─────────────────────────────
# Only needed for the live Slack/Gmail/GitHub/Drive/Discord sync in the product
# layer. The benchmark and the graph pipeline run fine without it.
COMPOSIO_API_KEY=
