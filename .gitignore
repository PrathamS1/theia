.venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Secrets & Private Helper Docs — NEVER commit
.env
PROGRESS.md
helperDoc/

# Raw dataset archives (large binary files, re-downloadable)
data/raw/

# Built vector index (rebuildable from data/staged_gold_docs.json via
# scripts/run_ingest.py or VectorStore.build_index)
data/vectors/

# Noisy-corpus artifacts (each >100MB, over GitHub's file limit).
# Rebuild with: bash scripts/download_dataset.sh --all
#           && python scripts/stage_noisy_corpus.py --distractors 25000 --seed 1337
# The seed makes the sample reproducible, so these need not be tracked.
data/staged_noisy_docs.json
data/staged_distractors_only.json
data/staged_distractors_remaining.json
data/vectors_noisy/

# HydraDB local storage
.hydradb/

# Python packaging artifacts
*.egg-info/
dist/
build/
.pytest_cache/
*.ipynb_checkpoints/

# Streamlit cache
.streamlit/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# SuiteSparse build (built locally in WSL, not needed in repo)
~/SuiteSparse/

# Local env backups
.env.bak

# Benchmark scratch runs. The committed results are eval_latest.json plus the
# two final per-corpus runs the README's headline numbers are read from:
#   data/eval_results/eval_gold_final_76.28.json
#   data/eval_results/eval_noisy_final_67.55.json
data/eval_results/eval_after_s3.json
data/eval_results/eval_baseline_pre_s3.json
data/eval_results/eval_cleanroom.json
data/eval_results/eval_full_pipeline.json

# NOTE: data/llm_facts_gold.json IS committed on purpose (852 KB). It is the
# Gemini-extracted fact cache the 76.28 / 67.55 numbers depend on, so a judge
# without a GEMINI_API_KEY still reproduces the benchmarked graph. See README §5.

# Local logs and editor scratch
*.log
.claude/
